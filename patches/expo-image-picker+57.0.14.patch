+  // Android may recreate the Activity while retaining this module. In that case
+  // its old launcher can have been unregistered by the destroyed Activity.
+  // Repair only that pre-launch failure, on the UI thread, and retry once.
+  private suspend fun launchImageLibraryWithRecovery(
+    contractOptions: ImageLibraryContractOptions
+  ): ImagePickerContractResult = withContext(Dispatchers.Main) {
+    try {
+      imageLibraryLauncher.launch(contractOptions)
+    } catch (error: IllegalStateException) {
+      if (error.message?.startsWith("Attempting to launch an unregistered ActivityResultLauncher") != true) {
+        throw error
+      }
+      imageLibraryLauncher = activityResultCaller.registerForActivityResult(
+        ImageLibraryContract(this@ImagePickerModule)
+      ) { input, result -> handleResultUponActivityDestruction(result, input.options) }
+      imageLibraryLauncher.launch(contractOptions)
+    }
+  }
