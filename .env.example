# Copy to apps/web/.env.local (and similar) when wiring real services.
# Never commit real secrets. Clients must not receive Housecall or AI keys.

# Supabase (public — safe for clients)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Expo (public — same values as NEXT_PUBLIC_ Supabase URL/anon key)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Next.js origin the phone should call. On a device, use the laptop's LAN URL, not localhost.
EXPO_PUBLIC_API_URL=
# Optional. EAS project id for Expo push tokens. Expo Go can omit this.
EXPO_PUBLIC_PROJECT_ID=
# Optional. Profile "Email support" mailto. If empty, the app tells the worker to ask their manager.
EXPO_PUBLIC_SUPPORT_EMAIL=

# Supabase (server only)
SUPABASE_SERVICE_ROLE_KEY=

# Expo Push (server only). Required only when enhanced push security is enabled in EAS.
EXPO_ACCESS_TOKEN=

# Housecall (server only)
HOUSECALL_API_KEY=
# Operational kill switches default off. For normal operation use all_jobs +
# manager_approved: active database managers/admins authorize each frozen receipt.
HOUSECALL_READS_ENABLED=false
HOUSECALL_ACCESS_MODE=test_jobs
HOUSECALL_EXPORT_MODE=disabled
# Exact HCP job IDs, comma separated; names are never an authorization boundary.
HOUSECALL_TEST_JOB_IDS=
HOUSECALL_ACTIVE_LOOKBACK_DAYS=30
HOUSECALL_ACTIVE_LOOKAHEAD_DAYS=90

# Vision / AI (server only)
AI_PROVIDER=gemini
# Use either GEMINI_API_KEY (preferred) or the provider-neutral AI_API_KEY fallback.
GEMINI_API_KEY=
AI_API_KEY=
# Stable default selected for RA-25. Override only during an intentional model migration.
GEMINI_MODEL=gemini-3.5-flash-lite
# RA-5 extraction is separately pinned; readability retains GEMINI_MODEL above.
GEMINI_EXTRACTION_MODEL=gemini-3.5-flash-lite
# Explicit receipt date convention for this U.S. business.
RECEIPT_DATE_ORDER=MDY
# Server-only deterministic suggestion settings. Changes require fixture regression.
RECEIPT_DUPLICATE_THRESHOLD=45
RECEIPT_DUPLICATE_AMOUNT_TOLERANCE_CENTS=0
RECEIPT_JOB_MAX_GPS_ACCURACY_METERS=100
RECEIPT_JOB_MAX_DISTANCE_KM=10
RECEIPT_JOB_MIN_SCORE=8

# Vercel cron (server only). Production and Preview must use different values.
CRON_SECRET=

# Required exact customer scope for test reads and job synchronization.
# Server reads also require HOUSECALL_TEST_JOB_IDS; empty scopes deny reads.
HOUSECALL_TEST_CUSTOMER_IDS=
# Optional, server-only. A bounded database authorization session for the
# integrated test environment. Keep empty outside an explicitly authorized test.
HOUSECALL_TEST_SESSION_ID=

# Optional Gmail receipt importer. Separate from CRON_SECRET; never expose publicly.
EMAIL_IMPORT_SECRET=
# Active manager/admin responsible for mailbox receipts.
EMAIL_IMPORT_OWNER_ID=

# Local synthetic preview flags have no effect in production.
# Start with npm run dev:labor-web to bind the preview to 127.0.0.1:3145.
LABOR_DEVELOPMENT_ENABLED=0
LABOR_LOCAL_PREVIEW=0
LABOR_APP_URL=http://127.0.0.1:3145
# Server/worker only; generate a private random token of at least 32 characters.
LABOR_WORKER_TOKEN=
# Optional private ledger path; otherwise .local/labor under the web working directory.
LABOR_DATA_DIR=
# Set only for an explicitly approved normal Supercrew Excel report download.
SUPERCREW_REPORT_DOWNLOADS_APPROVED=0

# Production Labor Hours: existing Supabase Auth roles and shared database/storage.
LABOR_ENABLED=0
LABOR_PERSISTENCE=supabase
# Hosted worker: exact HTTPS host (no path); encryption key stays on worker/GitHub only.
LABOR_APP_HOST=
LABOR_SESSION_ENCRYPTION_KEY=
# Optional repository-scoped Actions-write token for an immediate manual run.
LABOR_GITHUB_DISPATCH_TOKEN=
LABOR_GITHUB_REPOSITORY=Sammy-s-Visionary-Labs/svl-receipts
LABOR_GITHUB_REF=master
